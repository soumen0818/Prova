
# --- LOCAL DEVELOPMENT -----------------------------------------------------

# Where the Go backend is listening. The browser never calls this — Next.js does,
# from the server — so localhost is correct even when you open the site on a phone.
PROVA_API_URL=http://localhost:8080

# Sign-in for the console at /ops. Both are required and both are checked; there
# are no user accounts behind them, just the one operator.
# EITHER BEING UNSET MEANS NOBODY CAN SIGN IN — sign-in fails closed rather than
# treating "nothing configured" as "nothing required".
OPS_EMAIL=you@example.com
# QUOTE THE PASSWORD if it contains "#", a space, or quotes. An unquoted "#" starts
# a comment, so a value like  Secret#123  silently parses as  Secret  and every
# sign-in is refused with no clue why.
OPS_PASSWORD="change-me-locally"

# Signs the session cookie. Generate with:  openssl rand -hex 32
# The cookie holds only an expiry and this HMAC over it, so a stolen cookie cannot
# be extended and cannot be forged without this value. Changing it signs everyone out.
OPS_SESSION_SECRET=generate-with-openssl-rand-hex-32

# Bearer token for the backend's /ops routes. Must match COMPLIANCE_TOKEN in
# backend/.env — this is the secret that can approve anybody's KYC, so it stays on
# the server and never reaches the page.
COMPLIANCE_TOKEN=

# --- PRODUCTION ------------------------------------------------------------
#
# PROVA_API_URL=https://api.prova.example
# OPS_EMAIL=<the address that signs in to the console>
# OPS_PASSWORD=<long random passphrase, stored in your secret manager>
# OPS_SESSION_SECRET=<openssl rand -hex 32, different from every other environment>
# COMPLIANCE_TOKEN=<must equal the backend's COMPLIANCE_TOKEN>
#
# Also required in production:
#   - Serve over HTTPS. The session cookie is marked `secure` outside development,
#     so it will simply not be sent over plain HTTP and sign-in will appear to fail.
