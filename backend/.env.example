# Prova backend environment. Copy to .env (gitignored). Defaults target local + Stellar testnet.

APP_ENV=development
PORT=8080

# Local infra (see docker-compose.yml). POSTGRES_PORT/REDIS_PORT override the host ports if the
# defaults clash with another local instance (then adjust DATABASE_URL/REDIS_URL to match).
DATABASE_URL=postgres://prova:prova@localhost:5432/prova?sslmode=disable
REDIS_URL=redis://localhost:6379/0
# POSTGRES_PORT=5432
# REDIS_PORT=6379

# Stellar
STELLAR_NETWORK=testnet
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org

# Phase 2 — verifier contract + relayer (submits via the `stellar` CLI identity).
CONTRACT_ID=CAM5FO22PLIINNETME2CXFPS2WL7WCYOESYTLNYPQMWVKWDADWD4BTJC
RELAYER_KEY=prova-test
STELLAR_BIN=stellar

# Phase 2 — anchor (SEP-10 / SEP-24). Dev defaults use the SDF testanchor.
ANCHOR_HOME_DOMAIN=testanchor.stellar.org
ANCHOR_ASSET=SRT
# SEP10_SEED=  # optional; empty → an ephemeral key is generated at startup

# Phase 3 — KYC credential issuance. The anchor signs credentials via the prover CLI, so the
# Jubjub/Poseidon scheme always matches the circuit. Point PROVER_BIN at the built binary
# (circuits/prover/target/release/prova-prover) or install it on PATH.
PROVER_BIN=prova-prover
# ANCHOR_SEED=  # optional hex Jubjub anchor secret; empty → the CLI's built-in dev key
