# Prova mobile — environment template.
#
#   cp .env.example .env      then adjust
#
# Only EXPO_PUBLIC_* vars are exposed to the app, and they are inlined into the JavaScript bundle at
# build time. Assume anyone with the APK can read every value below, so NOTHING SECRET belongs here.
# There are no credentials in this file by design — every value is public configuration.
#
# ⚠️  THIS FILE CONFIGURES `npx expo start` ONLY.
#   EAS Build does not see .env: it is gitignored, and Expo does not upload gitignored files to
#   remote build jobs. What an APK is built with comes from the `env` block of the matching build
#   profile in eas.json. Add a variable in BOTH places, or it will work locally and fall back to a
#   default in the shipped app — the failure is silent.
#
# ⚠️  HOW TO RUN
#   Changing this file requires a restart of the Expo dev server (`npx expo start -c`) to take
#   effect — values are inlined at build/bundle time, not read at runtime.

# =============================================================================
# APP ENVIRONMENT
# =============================================================================
# LOCAL DEV: development   RELEASE BUILDS: production
EXPO_PUBLIC_APP_ENV=development

# LOCAL DEV / PRODUCTION-on-testnet: testnet   PRODUCTION-for-real: mainnet
# Selects the default Horizon/Soroban URLs and the network passphrase.
EXPO_PUBLIC_STELLAR_NETWORK=testnet

# Override individual Stellar endpoints. Leave unset to use the STELLAR_NETWORK defaults, which are
# correct for both testnet and mainnet — most projects never need these.
# EXPO_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
# EXPO_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# =============================================================================
# BACKEND                                                            [REQUIRED]
# =============================================================================
# The default is http://localhost:8080, which is correct on a simulator and useless in an APK — the
# phone would be calling itself. Always set this explicitly for a real build.
#
# LOCAL DEV:
#   Android emulator → host machine:   http://10.0.2.2:8080
#   iOS simulator / web:               http://localhost:8080
#   Physical device over USB:          http://localhost:8080 with `adb reverse tcp:8080 tcp:8080`
# RELEASE: the deployed API's HTTPS URL.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# =============================================================================
# SIGN-IN — email one-time codes (Docs/signup-and-validation.md)
# =============================================================================
#   development → if the backend is unreachable, a code is accepted on-device so the app works
#                 offline. Convenient locally; in a distributed build it is a sign-in bypass for
#                 anyone who turns off networking, so release profiles must use `production`.
#   production  → the backend emails a real code and the on-device path is gone.
EXPO_PUBLIC_AUTH_MODE=development

# =============================================================================
# FUNDING / DEPOSITS                                                 [REQUIRED]
# =============================================================================
# How "Add money" behaves — must match the backend's DEPOSIT_MODE:
#   simulated — credits a local counter instantly, no chain involved (fast local loop)
#   anchor    — real testnet/mainnet rails (funding + trustline + on-chain balance)
EXPO_PUBLIC_DEPOSIT_MODE=simulated

# The asset the wallet settles in — must match the backend's ANCHOR_ASSET, and what the app displays
# amounts in. A mismatch shows the wrong unit against a correct balance.
#
# There is deliberately no display-currency variable. A currency baked in at build time is one answer
# for every user of that build, which is wrong the moment senders are not all in one country — a US
# sender would be shown dirhams. When a licensed anchor is integrated, the currency it reports is
# recorded against the balance per user instead.
EXPO_PUBLIC_DEPOSIT_ASSET=SRT
