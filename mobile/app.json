{
  "expo": {
    "name": "prova-mobile",
    "slug": "prova-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "provamobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.prova.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.prova.app",
      "adaptiveIcon": {
        "backgroundColor": "#0E0E11",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E0E11",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 120
          }
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "62935c0a-816a-48a3-8f7d-833cd98a4d95"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/62935c0a-816a-48a3-8f7d-833cd98a4d95"
    }
  }
}
