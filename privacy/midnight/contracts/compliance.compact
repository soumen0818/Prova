pragma language_version 0.23;

import CompactStandardLibrary;
import "schnorr" prefix Schnorr_;

export { Schnorr_SchnorrSignature };

// Prova's Midnight role is deliberately narrow: privately prove that an authenticated credential
// satisfies the corridor policy, then publish one decision commitment bound to a Stellar spend.
// Stellar remains the value layer. Midnight never sees the amount, sender, recipient, or raw
// credential.

export struct ComplianceCredential {
  userId: Bytes<32>;
  kycLevel: Uint<8>;
  expiry: Uint<64>;
  credentialId: Bytes<32>;
  signature: Schnorr_SchnorrSignature;
}

// Public policy. The issuer key is a Jubjub point because its Schnorr signature is verified inside
// the zero-knowledge circuit. policyTime is an authority-maintained Unix timestamp: Compact 0.23
// has no chain-time primitive, so accepting a caller-provided timestamp would let an attacker pass
// zero and revive an expired credential.
export ledger minKycLevel: Uint<8>;
export ledger policyTime: Uint<64>;
export ledger policyAuthority: Bytes<32>;
export ledger credentialIssuer: JubjubPoint;

// The public cross-chain authorization surface. It stores a domain-separated hash of the Stellar
// nullifier, not the nullifier itself. Once the Stellar nullifier is published, observers can link
// the two transactions; before settlement, they cannot guess a random 32-byte nullifier.
export ledger approvedSettlements: Set<Bytes<32>>;

constructor(
  initialPolicyAuthority: Bytes<32>,
  initialCredentialIssuer: JubjubPoint,
  initialMinKyc: Uint<8>,
  initialPolicyTime: Uint<64>
) {
  policyAuthority = disclose(initialPolicyAuthority);
  credentialIssuer = disclose(initialCredentialIssuer);
  minKycLevel = disclose(initialMinKyc);
  policyTime = disclose(initialPolicyTime);
}

// Credential and holder material remain private. The issuer signs userId, level, expiry, and a
// random credentialId. holderSecret must derive the signed userId, preventing a copied credential
// package from being used by a different wallet.
witness complianceCredential(): ComplianceCredential;
witness credentialHolderSecret(): Bytes<32>;
witness policySecret(): Bytes<32>;

export pure circuit policyCommitment(secret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([secret, pad(32, "prova:policy:v2")]);
}

export pure circuit credentialUserId(holderSecret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([
    holderSecret,
    pad(32, "prova:credential-holder:v1")
  ]);
}

// Exported so the credential issuer signs exactly the message the circuit verifies.
export pure circuit credentialMessage(
  userId: Bytes<32>,
  kycLevel: Uint<8>,
  expiry: Uint<64>,
  credentialId: Bytes<32>
): Vector<4, Field> {
  return [
    transientHash<Bytes<32>>(userId),
    kycLevel as Field,
    expiry as Field,
    transientHash<Bytes<32>>(credentialId)
  ];
}

// Exported so the issuer can use the compiled contract's exact hash implementation.
export pure circuit schnorrChallenge(
  ann_x: Field,
  ann_y: Field,
  pk_x: Field,
  pk_y: Field,
  msg: Vector<4, Field>
): Field {
  return Schnorr_schnorrChallenge(ann_x, ann_y, pk_x, pk_y, msg);
}

export pure circuit settlementDecision(stellarNullifier: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([
    stellarNullifier,
    pad(32, "prova:stellar-eligibility:v1")
  ]);
}

circuit assertPolicyAuthority(): [] {
  assert(
    policyCommitment(policySecret()) == policyAuthority,
    "not authorised to change policy"
  );
}

// Prove one authenticated, holder-bound credential is eligible and authorize exactly one Stellar
// settlement. Reusing the same settlement nullifier is rejected on the Midnight ledger.
export circuit proveEligibility(stellarNullifier: Bytes<32>): Bytes<32> {
  const credential = complianceCredential();

  assert(
    credentialUserId(credentialHolderSecret()) == credential.userId,
    "credential belongs to another holder"
  );

  const message = credentialMessage(
    credential.userId,
    credential.kycLevel,
    credential.expiry,
    credential.credentialId
  );
  Schnorr_schnorrVerify<4>(message, credential.signature, credentialIssuer);

  assert(credential.expiry >= policyTime, "credential has expired");
  assert(
    credential.kycLevel >= minKycLevel,
    "KYC level below the required minimum"
  );

  const decision = disclose(settlementDecision(stellarNullifier));
  assert(!approvedSettlements.member(decision), "settlement already authorised");
  approvedSettlements.insert(decision);
  return decision;
}

export circuit setMinKycLevel(newMinimum: Uint<8>): [] {
  assertPolicyAuthority();
  minKycLevel = disclose(newMinimum);
}

// The authority may advance time but cannot move it backwards to revive expired credentials.
export circuit setPolicyTime(newPolicyTime: Uint<64>): [] {
  assertPolicyAuthority();
  assert(newPolicyTime >= policyTime, "policy time cannot move backwards");
  policyTime = disclose(newPolicyTime);
}

// Rotation invalidates credentials signed only by the old issuer, matching the Stellar pool's
// emergency anchor-rotation behavior.
export circuit setCredentialIssuer(newIssuer: JubjubPoint): [] {
  assertPolicyAuthority();
  credentialIssuer = disclose(newIssuer);
}
