    "typescript": "~6.0.3"
  },
  "scripts": {
    "//eas-build-post-install": "EAS Build hook: runs after npm install and prebuild, before Metro bundles. @prova/shared is a file:../shared dependency whose package `main` points at ./dist/index.js, and shared/dist is a build artifact excluded from git — so on a clean EAS checkout it does not exist and bundling dies with 'none of these files exist'. It works locally only because dist/ is already sitting on disk from an earlier build. --include=dev because typescript is a devDependency and EAS may run with NODE_ENV=production, which would otherwise skip it and leave tsc missing.",
    "eas-build-post-install": "cd ../shared && npm ci --include=dev && npm run build",
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "private": true
}
