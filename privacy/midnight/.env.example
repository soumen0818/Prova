# Deployment secrets for the Midnight privacy layer.
#
# Copy to `.env` and fill in. `.env` is gitignored (root .gitignore, `.env.*`); this example is not,
# and must never contain real values.
#
#   cp .env.example .env
#   $EDITOR .env
#
# Deployment commands load `.env` directly:
#   npm run deploy:check

# The key that controls the corridor's KYC policy, 64 hex characters.
#
# Generate with:  openssl rand -hex 32
#
# The deployed contract stores only `policyCommitment(secret)` — publishing that commitment reveals
# nothing, which is why the authority is a commitment rather than an address.
#
# This cannot be changed after deployment. Losing it means the policy is frozen at whatever it was
# deployed with, which is the failure this constructor exists to prevent — reached by another route.
# Keep a copy somewhere you will still have it in six months.
POLICY_SECRET=


# The Jubjub secret used by the compliance issuer to sign credentials. The contract stores only its
# public key. Keep this separate from POLICY_SECRET so policy administration and credential issuance
# can be rotated independently.
#
# Generate safely with:  npm run issuer:new
# Show only the public key with:  npm run issuer:show
CREDENTIAL_ISSUER_SECRET=""

# Midnight's contract-maintenance signing key. This controls verifier-key and maintenance-authority
# changes; it is separate from the in-contract policy secret. The deployer supplies it explicitly so
# a failure while persisting SDK state cannot leave the deployed maintenance authority unrecoverable.
#
# Generate safely with:  npm run maintenance:new
# Show only the public verifying key with:  npm run maintenance:show
CONTRACT_MAINTENANCE_KEY=""

# The deployment wallet seed — 32 bytes, hex encoded.
#
# NOT a Lace 24-word mnemonic. Lace derives its seed by its own internal scheme; three standard
# BIP39 derivations (seed first 32 bytes, last 32 bytes, raw entropy) were each tested against a
# known Lace address and none reproduced it, so a mnemonic cannot be converted here.
#
# Generate one with the same SDK that consumes it, which writes it straight into .env:
#
#   npm run wallet:new
#
# That prints the address to fund and keeps the seed off stdout and out of shell history.
MIDNIGHT_WALLET_SEED=""

# Optional. The corridor's minimum KYC level, applied to the compliance contract at construction.
# Defaults to 1 — deliberately non-zero, so the check can actually reject something.
# REQUIRED_KYC=1

# Optional. The trusted policy timestamp stored at construction. Defaults to deployment time and can
# only move forward through an authorised contract call. Credential expiry is checked against this
# ledger value, never against a caller-provided timestamp.
# POLICY_TIME=1700000000

# Optional. Always local: the proof server receives private credential and holder witness material,
# so pointing it at a machine you do not control hands over exactly what this layer protects.
# PROOF_SERVER=http://localhost:6300
