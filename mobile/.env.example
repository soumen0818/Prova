# Prova mobile — environment variables.
# Copy to `.env` and adjust. Only EXPO_PUBLIC_* vars are exposed to the app (client-safe only —
# never put secrets here). Defaults (in src/config/env.ts) target Stellar testnet.

# development | staging | production
EXPO_PUBLIC_APP_ENV=development

# testnet | mainnet  (selects default Horizon / Soroban / passphrase)
EXPO_PUBLIC_STELLAR_NETWORK=testnet

# Override Stellar endpoints (leave unset to use network defaults)
# EXPO_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
# EXPO_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Prova backend (Go API)
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# Phone-login credential mode.
#   development → OTP is bypassed on-device with a fixed code (no SMS; works offline). The dev phone
#                 + code below are pre-filled so sign-in is one tap.
#   production  → OTP is requested/verified through the backend (real SMS provider). Flip this when
#                 real credentials are wired — no code changes needed.
EXPO_PUBLIC_AUTH_MODE=development
EXPO_PUBLIC_DEV_PHONE=+971 50 123 4567
EXPO_PUBLIC_DEV_OTP=000000

# Funding-side display currency.
EXPO_PUBLIC_CURRENCY=AED

# Optional: Sentry DSN for error reporting (empty = disabled)
# EXPO_PUBLIC_SENTRY_DSN=
