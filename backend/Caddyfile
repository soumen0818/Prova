# TLS and reverse proxy for the Prova backend.
#
# Caddy obtains and renews a Let's Encrypt certificate for API_DOMAIN by itself, provided the domain
# resolves to this machine and ports 80 and 443 are reachable. HTTP is redirected to HTTPS
# automatically — the mobile app will not talk to a plain-HTTP backend, and neither should anything
# else carrying a sign-in code.

{$API_DOMAIN} {
	# The API listens on loopback (see docker-compose.prod.yml); `api` resolves on the compose
	# network, so nothing has to be exposed to the host for this hop.
	# Caddy sets X-Forwarded-For and X-Forwarded-Proto on proxied requests by itself. The backend
	# reads the first for per-IP rate limiting, and with TRUST_PROXY_HEADERS=true it trusts them —
	# safe only because this proxy sets them and is the sole route in.
	#
	# (`header_up` is a subdirective of reverse_proxy, not a site-level one. Writing it here as a
	# bare directive is a config error that puts Caddy in a restart loop.)
	reverse_proxy api:8080

	encode gzip

	# Health checks are noise in an access log and are polled constantly.
	log {
		output stdout
		format console
	}
}

# The website and the operator console. A separate hostname on the same machine and the same Caddy:
# requests are routed by the Host header, so one IP serves both.
{$WEB_DOMAIN} {
	reverse_proxy web:3000

	encode gzip

	log {
		output stdout
		format console
	}
}
