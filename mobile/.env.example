# Prova mobile — environment template.
#
#   cp .env.example .env      then adjust
#
# Only EXPO_PUBLIC_* vars are exposed to the app (inlined into the bundle at build time).
# NEVER put a secret here — assume anyone with the APK/IPA can read every value below.
#
# ⚠️  HOW TO RUN
#   Changing this file requires a restart of the Expo dev server (`npx expo start -c`) to take
#   effect — values are inlined at build/bundle time, not read at runtime.

# =============================================================================
# APP ENVIRONMENT
# =============================================================================
# LOCAL DEV: development   PRODUCTION: production
EXPO_PUBLIC_APP_ENV=development

# LOCAL DEV / PRODUCTION-on-testnet: testnet   PRODUCTION-for-real: mainnet
# Selects the default Horizon/Soroban URLs and network passphrase below.
EXPO_PUBLIC_STELLAR_NETWORK=testnet

# Override individual Stellar endpoints. Leave unset to use the STELLAR_NETWORK defaults.
# EXPO_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
# EXPO_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# =============================================================================
# BACKEND
# =============================================================================
# LOCAL DEV:
#   Android emulator → host machine:  http://10.0.2.2:8080
#   iOS simulator / web:              http://localhost:8080
#   Physical device on the same Wi-Fi: http://<your-machine-LAN-IP>:8080
# PRODUCTION: your deployed API's HTTPS URL.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# =============================================================================
# SIGN-IN — email one-time codes (Docs/signup-and-validation.md)
# =============================================================================
#   LOCAL DEV  → OTP is bypassed on-device with a fixed code, no email sent, works offline.
#                Must match the backend's DEV_OTP for the dev bypass to succeed.
#   PRODUCTION → the backend actually emails a code; this device-side bypass no longer applies.
EXPO_PUBLIC_AUTH_MODE=development
EXPO_PUBLIC_DEV_EMAIL=you@example.com
EXPO_PUBLIC_DEV_OTP=000000

# =============================================================================
# FUNDING / DEPOSITS
# =============================================================================
EXPO_PUBLIC_CURRENCY=AED

# How "Add money" behaves — must match the backend's DEPOSIT_MODE:
#   LOCAL DEV:  simulated — credits a local counter instantly, no chain involved
#   PRODUCTION-like: anchor — real testnet/mainnet rails (funding + trustline + on-chain balance)
EXPO_PUBLIC_DEPOSIT_MODE=simulated
EXPO_PUBLIC_DEPOSIT_ASSET=SRT

# =============================================================================
# OPTIONAL FEATURES
# =============================================================================
# Google OAuth WEB client ID — needed for Google Drive cloud backup on Android (iOS uses iCloud).
#   ← SET THIS to enable Drive backup on Android. Empty = backup shows "setup required".
#   Create in Google Cloud console — see Docs/account-recovery.md, Phase B setup.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# Sentry DSN for crash/error reporting.
#   ← SET THIS for PRODUCTION. Empty = disabled, safe default for LOCAL DEV.
# EXPO_PUBLIC_SENTRY_DSN=
