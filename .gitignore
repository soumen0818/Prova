# --- Prova monorepo root ignores ---
# (each subproject also has its own .gitignore for toolchain-specific files)


# OS / editor
.DS_Store
*.swp
.idea/
*.log

# Env / secrets (subprojects keep their own .env.example tracked)
.env
.env.*
!.env.example
# The production template is placeholders only and is referenced by Docs/deployment.md. Without this
# it is swallowed by `.env.*` above, so a fresh clone hits "No such file or directory" at the copy
# step — which is exactly what happened on the first EC2 deploy.
!.env.production.example

# Node
node_modules/

# Rust
target/

# Go
bin/
# ...but Rust source bin dirs (src/bin/*.rs) are source, not build output
!**/src/bin/

# Build output
dist/
build/
