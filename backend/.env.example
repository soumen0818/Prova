# Prova backend environment. Copy to .env (gitignored). Defaults target local + Stellar testnet.

APP_ENV=development
PORT=8080

# Local infra (see docker-compose.yml)
DATABASE_URL=postgres://prova:prova@localhost:5432/prova?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Stellar
STELLAR_NETWORK=testnet
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org
