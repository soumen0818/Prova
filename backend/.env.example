# Prova backend environment. Copy to .env (gitignored). Defaults target local + Stellar testnet.

APP_ENV=development
PORT=8080

# Process role (lets the same image scale as separate roles):
#   all      → HTTP API + embedded indexer (single-container / dev default)
#   api      → HTTP API only (scale these behind a load balancer)
#   indexer  → the on-chain indexer only (run exactly one replica)
RUN_MODE=all

# Set true when connecting through a transaction-mode connection pooler that doesn't support
# prepared statements — notably Supabase's *pooled* endpoint. Direct/session connections: leave false.
DB_SIMPLE_PROTOCOL=false

# Local infra (see docker-compose.yml). POSTGRES_PORT/REDIS_PORT override the host ports if the
# defaults clash with another local instance (then adjust DATABASE_URL/REDIS_URL to match).
DATABASE_URL=postgres://prova:prova@localhost:5432/prova?sslmode=disable
REDIS_URL=redis://localhost:6379/0
# POSTGRES_PORT=5432
# REDIS_PORT=6379

# Stellar
STELLAR_NETWORK=testnet
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org

# Phase 2 — verifier contract + relayer (signs/submits via the `stellar` CLI, which is bundled in
# the Docker image). RELAYER_KEY may be a CLI identity name (local dev) OR a funded Stellar SECRET
# seed (S…) — use the secret seed in Docker so no keystore/identity setup is needed.
CONTRACT_ID=CAM5FO22PLIINNETME2CXFPS2WL7WCYOESYTLNYPQMWVKWDADWD4BTJC
RELAYER_KEY=prova-test
STELLAR_BIN=stellar

# Phase 2 — anchor (SEP-10 / SEP-24). Dev defaults use the SDF testanchor.
ANCHOR_HOME_DOMAIN=testanchor.stellar.org
ANCHOR_ASSET=SRT
# ANCHOR_ASSET_ISSUER=  # issuer (G…) of the asset; empty → discovered from the anchor's stellar.toml
# SEP10_SEED=  # optional; empty → an ephemeral key is generated at startup

# How "Add money" works (independent of AUTH_MODE):
#   simulated → the app credits a local testnet balance (fast dev loop, no chain)
#   anchor    → real testnet rails: Friendbot funding + trustline + on-chain balance from Horizon
# Still testnet — the asset has no real value. Keep in sync with the app's EXPO_PUBLIC_DEPOSIT_MODE.
DEPOSIT_MODE=simulated

# Phase 3 — KYC credential issuance. The anchor signs credentials via the prover CLI, so the
# Jubjub/Poseidon scheme always matches the circuit. Point PROVER_BIN at the built binary
# (circuits/prover/target/release/prova-prover) or install it on PATH.
PROVER_BIN=prova-prover
# ANCHOR_SEED=  # optional hex Jubjub anchor secret; empty → the CLI's built-in dev key

# KYC verification (Docs/kyc-verification.md). Credentials are issued ONLY against a stored
# `approved` verification record — never on request alone.
#   KYC_WEBHOOK_SECRET: HMAC-SHA256 secret for the provider webhook (X-Prova-Signature).
#                       Empty = signature check skipped — LOCAL DEV ONLY, set it in staging/prod.
#   KYC_MOCK_DELAY_SECONDS: simulated provider latency for the Stage A mock provider.
# KYC_WEBHOOK_SECRET=
KYC_MOCK_DELAY_SECONDS=4

# Phone-login OTP. development → accepts the fixed DEV_OTP for any number (no SMS sent).
# production → requires a real SMS provider (not yet wired; /auth/otp/* returns 501 until then).
AUTH_MODE=development
DEV_OTP=000000
