{
  "expo": {
    "name": "Prova",
    "slug": "prova-mobile",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "provamobile",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0E0E11",
    "ios": {
      "bundleIdentifier": "com.prova.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.prova.app",
      "backgroundColor": "#0E0E11",
      "adaptiveIcon": {
        "backgroundColor": "#0E0E11",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E0E11",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 160,
            "resizeMode": "contain"
          }
        }
      ],
      "expo-secure-store",
      "react-native-cloud-storage",
      "@react-native-google-signin/google-signin",
      "./plugins/with-prova-android.js",
      "expo-image",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": ["arm64-v8a"]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "62935c0a-816a-48a3-8f7d-833cd98a4d95"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/62935c0a-816a-48a3-8f7d-833cd98a4d95"
    }
  }
}
