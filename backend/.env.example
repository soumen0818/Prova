# Prova backend — environment template.
#
#   cp .env.example .env      then fill in the values marked ← SET THIS
#
# Full explanations live in the docs, not here — this file is meant to stay short and scannable:
#   Docs/deployment-and-keys.md      contract addresses, which key goes where, admin operations
#   Docs/signup-and-validation.md    email codes, rate limiting
#
# ⚠️  HOW TO RUN
#   Docker (`docker compose up`)  → loads this file automatically.
#   Bare `go run ./cmd/api`       → does NOT load it. Source it into your shell first:
#                                      set -a && source .env && set +a && go run ./cmd/api
#                                    Skipping this means every value below is silently ignored and
#                                    the code's built-in defaults are used instead.

# =============================================================================
# SERVER
# =============================================================================
APP_ENV=development
PORT=8080

# Which role this process runs (the same binary/image serves all three):
#   all      LOCAL DEV — API + indexer in one process
#   api      PRODUCTION — HTTP only, scaled horizontally behind a load balancer
#   indexer  PRODUCTION — the on-chain indexer + pool folder; run exactly ONE replica of this
RUN_MODE=all

# Trust X-Forwarded-For / X-Real-IP for rate-limiting.
#   LOCAL DEV / no proxy: false
#   PRODUCTION behind a load balancer you control: true — otherwise leave false, since trusting
#   this blindly lets a client fake their IP and bypass every rate limit.
TRUST_PROXY_HEADERS=false

# =============================================================================
# DATABASE & CACHE
# =============================================================================
# LOCAL DEV (Docker):  `make up` starts these for you at the URLs below.
# PRODUCTION:          point at your managed Postgres/Redis instead.
DATABASE_URL=postgres://prova:prova@localhost:5432/prova?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Set true only for a transaction-mode pooler that doesn't support prepared statements
# (e.g. Supabase's *pooled* endpoint). Leave false for a direct/session connection.
DB_SIMPLE_PROTOCOL=false

# Docker Compose only (ignored by bare `go run`). Change the HOST port if 5432/6379 are already
# taken by something else on your machine — then update DATABASE_URL/REDIS_URL above to match.
# POSTGRES_PORT=5432
# REDIS_PORT=6379

# =============================================================================
# STELLAR NETWORK
# =============================================================================
STELLAR_NETWORK=testnet
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_BIN=stellar

# =============================================================================
# CONTRACTS — public identifiers, safe to commit and share
# =============================================================================
# The Phase-2 KYC verifier. See contracts/DEPLOYMENTS.md for every deployed address.
CONTRACT_ID=CAM5FO22PLIINNETME2CXFPS2WL7WCYOESYTLNYPQMWVKWDADWD4BTJC

# The shielded pool — a SEPARATE contract, deployed by contracts/scripts/deploy_pool_testnet.sh.
# ← SET THIS after you deploy (Docs/deployment-and-keys.md §4).
# POOL_CONTRACT_ID=

# Must match the seed the pool contract's embedded verifying keys were built with, or every proof
# this backend produces is rejected on-chain. Do not change without redeploying.
POOL_SETUP_SEED=42

# =============================================================================
# RELAYER & FOLDER — low-value operational keys (safe to rotate, cannot move user funds directly)
# =============================================================================
# Signs/submits transactions on users' behalf. A CLI identity name (LOCAL DEV) or a funded
# Stellar SECRET seed, S… (PRODUCTION / Docker, so no keystore setup is needed in the container).
RELAYER_KEY=prova-test

# Cache for the pool folder's proving key (~27MB, ~1.5s to build once). Safe to delete — costs
# time on the next fold, never correctness. Leave unset to rebuild it every time (slower).
# POOL_FOLD_KEY_CACHE=/var/lib/prova/fold_pk.bin

# How often queued notes are folded into the tree — the "money is spendable in N seconds" delay
# users feel after a transfer.
POOL_FOLD_INTERVAL_SECONDS=8

# =============================================================================
# PROVER CLI — needed for KYC credential issuance and the pool folder
# =============================================================================
# Path to the built binary, or a bare name if it's on PATH.
#   LOCAL DEV:  circuits/prover/target/release/prova-prover (build it first: cargo build --release)
#   Docker:     already on PATH inside the image — leave as "prova-prover"
PROVER_BIN=prova-prover

# The anchor's KYC-signing key (hex Jubjub scalar). Empty → the CLI's built-in dev key.
# ⚠️  Can forge "verified" credentials, not move money. See Docs/deployment-and-keys.md §1.
# ANCHOR_SEED=

# =============================================================================
# ANCHOR / DEPOSITS (SEP-10 / SEP-24)
# =============================================================================
ANCHOR_HOME_DOMAIN=testanchor.stellar.org
ANCHOR_ASSET=SRT
# Issuer (G…) of ANCHOR_ASSET. Empty → discovered from the anchor's stellar.toml at startup.
# ANCHOR_ASSET_ISSUER=
# Empty → an ephemeral SEP-10 key is generated at startup (fine for LOCAL DEV).
# SEP10_SEED=

# How "Add money" behaves — independent of AUTH_MODE:
#   simulated  LOCAL DEV — credits a local counter instantly, no chain involved
#   anchor     PRODUCTION-like — real testnet rails (funding + trustline + on-chain balance)
# Keep in sync with the app's EXPO_PUBLIC_DEPOSIT_MODE.
DEPOSIT_MODE=simulated

# =============================================================================
# KYC VERIFICATION
# =============================================================================
# HMAC-SHA256 secret the verification provider signs its webhook with (X-Prova-Signature).
#   LOCAL DEV: leave empty — signature checking is skipped.
#   PRODUCTION: required — an unsigned webhook must not be trusted.
# KYC_WEBHOOK_SECRET=
KYC_MOCK_DELAY_SECONDS=4

# Bearer token required on POST /kyc/verifications/{id}/decide — the manual compliance-review
# endpoint. Without this, anyone who knows/guesses a userId can self-approve their own KYC.
#   LOCAL DEV: leave empty — the check is skipped.
#   PRODUCTION: required. Send as `Authorization: Bearer <token>`.
# COMPLIANCE_TOKEN=

# =============================================================================
# SIGN-IN — email one-time codes (Docs/signup-and-validation.md §6)
# =============================================================================
#   LOCAL DEV, SMTP unset below → DEV_OTP is accepted for any address, nothing is sent.
#   PRODUCTION                  → SMTP is required; sign-in is refused without it.
AUTH_MODE=development
DEV_OTP=000000

# Gmail via SMTP works free for testnet (~500 emails/day cap). Needs an APP PASSWORD, not your
# account password — Google Account → Security → 2-Step Verification → App passwords.
# Leave SMTP_HOST empty to keep using DEV_OTP.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=
# SMTP_FROM=you@gmail.com
# SMTP_FROM_NAME=Prova

# =============================================================================
# MAINTENANCE MODE
# =============================================================================
# Announced via /healthz so the app shows its maintenance screen from a server signal — flip
# without shipping a release.
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="We are carrying out scheduled maintenance. Your funds and account are safe."
# MAINTENANCE_UNTIL=
